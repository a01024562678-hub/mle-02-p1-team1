digraph ProjectStructure {
  graph [rankdir=LR, fontname="Malgun Gothic"];
  node [shape=box, fontname="Malgun Gothic"];
  edge [fontname="Malgun Gothic"];

  subgraph cluster_program {
    label="프로그램 계층";
    user [label="User / 실행"];
    bat [label="run_car_search.bat"];
    main [label="car_search/coffee_search.py"];
    service [label="CoffeeSearchService"];
    pdf [label="car_search_rag/data/에센자미니_c30.pdf"];
    session [label="common/SqlSession"];
    mapper [label="aiosql Mapper\ncar_search/*.sql"];
    db [label="PostgreSQL / pgvector", shape=cylinder];
    user -> main -> service -> session -> mapper -> db;
    user -> bat -> main;
    pdf -> service;
  }

  subgraph cluster_rag {
    label="RAG 검색 및 답변 흐름 (향후 연결)";
    question [label="User Question"];
    embedding [label="Embedding"];
    search [label="Vector Search"];
    context [label="Retrieved Context"];
    llm [label="LLM"];
    answer [label="Answer"];
    question -> embedding -> search -> context -> llm -> answer;
  }

  db -> search [style=dashed, label="검색 대상"];
}
